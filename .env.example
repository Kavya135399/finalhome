# Server Configuration
PORT=5000
NODE_ENV=production

# Razorpay Credentials
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/homeseva?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Nodemailer / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM=HomeSeva Payments <noreply@homeseva.com>

# Company Details for Invoice
COMPANY_NAME=HomeSeva Services Pvt Ltd
COMPANY_GST=27AAACH6542R1Z2
COMPANY_ADDRESS=Suite 404, Tech Park, Mumbai, MH, 400001
COMPANY_PHONE=+91 98765 43210
